# Test List:
.pos 0
    irmovq array,%r11
    irmovq $3,%r12          # 3
    rmmovq %r12,(%r11)
    irmovq $5,%r12          # 5
    rmmovq %r12,8(%r11)
    irmovq $8,%r12          # 8
    rmmovq %r12,16(%r11)
    irmovq $0,%r12          # ending zero
    rmmovq %r12,24(%r11)

# x is fibonacci if 5*x*x+4 or 5*x*x-4 is a perfect square
# rax = 0 if all are fibonacci, if not rax = first number that is not

main:
    irmovq stack,%rsp
    irmovq array,%r11       #pointer to the list

listLoop:
    mrmovq (%r11),%rbx      #x
    andq %rbx,%rbx
    je allFib               #zero = end of list

    rrmovq %rbx,%rdi
    rrmovq %rbx,%rsi
    call mult               #rax = x*x
    rrmovq %rax,%rcx
    addq %rax,%rax          #2*x*x
    addq %rax,%rax          #4*x*x
    addq %rcx,%rax          #5*x*x
    irmovq $4,%rcx
    addq %rcx,%rax          #5*x*x+4
    rrmovq %rax,%r12        #save it in r12

    rrmovq %r12,%rdi
    call square
    andq %rax,%rax
    jne isFib               #5*x*x+4 is square

    irmovq $8,%rcx
    rrmovq %r12,%rdi
    subq %rcx,%rdi          #5*x*x-4
    call square
    andq %rax,%rax
    jne isFib               #5*x*x-4 is square

notFib:
    rrmovq %rbx,%rax        #not fibonacci, return it
    halt

isFib:
    irmovq $8,%rcx
    addq %rcx,%r11          #next number
    jmp listLoop

allFib:
    irmovq $0,%rax
    halt

# rax = rdi * rsi
mult:
    irmovq $0,%rax
    irmovq $1,%rcx          #control bit
multLoop:
    rrmovq %rsi,%rdx
    subq %rcx,%rdx          #if control bit > rsi stop
    jl multEnd
    rrmovq %rsi,%rdx
    andq %rcx,%rdx          #bit is 1?
    je shift
    addq %rdi,%rax          #add
shift:
    addq %rdi,%rdi          #rdi*2
    addq %rcx,%rcx          #move control bit left
    jmp multLoop
multEnd:
    ret

# rax = 1 if rdi is a perfect square, 0 if not
# n - 1 - 3 - 5 - 7 ... is 0 only if n is a square
square:
    irmovq $1,%rcx          #odd number
    irmovq $2,%rdx
squareLoop:
    subq %rcx,%rdi
    je yes                  #0 = square
    jl no                   #negative = not square
    addq %rdx,%rcx          #next odd
    jmp squareLoop
yes:
    irmovq $1,%rax
    ret
no:
    irmovq $0,%rax
    ret

.pos 0x700
array:

.pos 0x1000
stack:
